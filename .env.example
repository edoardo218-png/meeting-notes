# Meeting Notes: configurazione. Copia in ~/.config/meeting-notes/.env
# Tutte le voci sono opzionali.

# --- Trascrizione ---------------------------------------------------------
# Default: trascrizione di macOS (on-device, macOS 26+). Nessuna installazione extra.
# Se è presente GROQ_API_KEY o OPENAI_API_KEY si usa la Whisper API (Groq ha la precedenza).
# TRANSCRIBE_PROVIDER=apple        # forza: apple | whisper | groq | openai
# TRANSCRIBE_LANGUAGE=auto         # es. it, en. Con "auto" Apple usa NOTES_LANGUAGE
# GROQ_API_KEY=
# OPENAI_API_KEY=
# whisper.cpp (solo con TRANSCRIBE_PROVIDER=whisper, installalo con: scripts/install-deps.sh --whisper)
# WHISPER_MODEL_PATH=~/.local/share/meeting-notes/models/ggml-medium.bin
# WHISPER_VAD_MODEL_PATH=~/.local/share/meeting-notes/models/ggml-silero-v5.1.2.bin

# --- Riepilogo (LLM) ------------------------------------------------------
# Default: Claude Code CLI ("claude -p") con il tuo abbonamento Claude, nessuna API key necessaria.
# Poi, se presenti, le API key: Anthropic → OpenAI → Groq. Ollama solo se non c'è altro.
# LLM_PROVIDER=claude              # forza: claude | anthropic | openai | groq | ollama | none
#                                  # none = salva solo il transcript, il riassunto lo chiedi tu a Claude
# CLAUDE_MODEL=sonnet
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_MODEL=gpt-4.1-mini
# GROQ_MODEL=llama-3.3-70b-versatile
# OLLAMA_MODEL=qwen2.5:14b
# OLLAMA_URL=http://localhost:11434

# --- Output ---------------------------------------------------------------
# NOTES_DIR=~/MeetingNotes
# NOTES_LANGUAGE=it                # lingua di riepilogo/decisioni/action item
# MY_NAME=Io                       # etichetta del microfono nel transcript
# OTHERS_NAME=Altri                # etichetta dell'audio di sistema

# --- Percorsi binari (se non sono in /opt/homebrew/bin o ~/.local/bin) -----
# FFMPEG_PATH=
# WHISPER_CLI_PATH=
# CLAUDE_PATH=
